# ── tg-api · Railway environment variables ──────────────────────────────────
# Set these in the Railway service → Variables. Do NOT commit real secrets.

NODE_ENV=production
# Railway injects PORT automatically; the app reads it. Leave HOST as-is.
HOST=0.0.0.0
LOG_LEVEL=info

# Allow the Vercel app's origin (browser only hits it directly on CORS
# preflight; the proxy path is server-to-server). Comma-separated, no spaces.
CORS_ORIGINS=https://YOUR-APP.vercel.app

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Runtime: TRANSACTION POOLER (port 6543, pgbouncer). prepare:false is set in code.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations only: DIRECT connection (port 5432). Used by `drizzle-kit migrate`.
DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# MUST be identical to tg-ui's JWT_SECRET (the Next middleware verifies the
# session cookie with it). Generate once: `openssl rand -hex 32`
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_TTL=12h
BCRYPT_ROUNDS=12
MFA_CHALLENGE_TTL_SECONDS=300
# Set false to skip the 2FA PIN step (no email/SMS provider wired for codes yet).
MFA_ENABLED=false

# ── App / email ──────────────────────────────────────────────────────────────
# Public origin of the deployed web app — used to build invite / reset links.
APP_URL=https://YOUR-APP.vercel.app
# Resend API key. Leave empty to log magic links to the Railway console instead.
RESEND_API_KEY=
MAIL_FROM=Technograph <onboarding@your-domain.com>
INVITE_TTL_HOURS=168
SESSION_COOKIE_NAME=tg_session
