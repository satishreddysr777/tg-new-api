# --- Runtime ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Database (Postgres + Drizzle) ---
# Local dev: any Postgres. Production: DigitalOcean Managed Postgres, injected
# by App Platform as ${db.DATABASE_URL} (includes ?sslmode=require).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/technograph
DB_POOL_MAX=10
# PEM CA certificate for a managed cluster (DigitalOcean: ${db.CA_CERT}).
# Leave empty locally.
DATABASE_CA_CERT=

# --- Auth ---
# Generate a strong value for non-dev: `openssl rand -hex 32`
# NOTE: must match tg-ui's JWT_SECRET so the Next middleware can verify sessions.
JWT_SECRET=dev-only-insecure-change-me-please
# Doubles as the session-cookie lifetime (no refresh token yet).
JWT_ACCESS_TTL=12h
BCRYPT_ROUNDS=12
MFA_CHALLENGE_TTL_SECONDS=300
# Post-login 2FA (PIN). Set to false to TEMP bypass it — login returns a token
# directly with no code step. Defaults to true.
MFA_ENABLED=true

# --- App / email (invites & password resets) ---
# Public origin of the web app — used to build invite / reset magic links.
APP_URL=http://localhost:3000
# Resend API key. Leave empty to log magic links to the console (dev fallback).
RESEND_API_KEY=
MAIL_FROM=Technograph <onboarding@technograph.io>
# Onboarding invite link lifetime, in hours.
INVITE_TTL_HOURS=168
# Name of the httpOnly session cookie.
SESSION_COOKIE_NAME=tg_session
